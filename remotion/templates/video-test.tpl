/* Generated by scripts/new-video.mjs for videos/__SLUG__: the checks a new video passes before it is handed back (DESIGN.md section 0b). Add
   "node tests/__SLUG__.test.ts" to the test script in package.json so `npm test` runs it. It reads the story and the plan, and runs the checker. */
import assert from "node:assert/strict";
import { readFileSync } from "node:fs";
import { spawnSync } from "node:child_process";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { makePlan } from "../videos/__SLUG__/plan.ts";
import { validateStory } from "../src/schema.ts";

let n = 0;
const yes = (c: boolean, what: string) => { n++; assert.ok(c, what); };
const ROOT = path.join(path.dirname(fileURLToPath(import.meta.url)), "..");
const dir = path.join(ROOT, "videos", "__SLUG__");
const raw = JSON.parse(readFileSync(path.join(dir, "story.json"), "utf8"));
const v = validateStory(raw);
yes(v.ok, `the story of videos/__SLUG__ is valid${v.ok ? "" : `: ${v.errors.join("; ")}`}`);
if (!v.ok) { console.log(`__SLUG__: ${n} checks ok (the story is not valid)`); process.exit(1); }
const story = v.story;

// the timing: the sting right after the hook, the loop-back last, the plan's times are the beats'
const P = makePlan(story);
yes(P.total === story.duration, "the plan's total is the story's duration");
yes(P.m.sting === story.beats[0].dur, "the sting starts where the hook ends (must 1)");
yes(story.beats.at(-1)?.kind === "outro" && P.m.outro === P.total - story.beats.at(-1)!.dur, "the outro starts at the last beat (must 2)");
yes(P.loopWeight(P.m.outro) === 0 && P.loopWeight(P.total) === 1, "the loop weight runs from 0 at the outro to 1 at the end");

// the checker: no FAIL (the musts and the motion language); its flags are read in the report, not hidden
const check = spawnSync(process.execPath, [path.join(ROOT, "scripts", "styleCheck.mjs"), "__SLUG__"], { encoding: "utf8" });
yes(!/^FAIL/m.test(check.stdout), `the checker has no FAIL line:\n${check.stdout.split("\n").filter((l) => /^FAIL/.test(l)).join("\n")}`);

console.log(`__SLUG__: ${n} checks ok`);
