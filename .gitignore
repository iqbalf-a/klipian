__pycache__/
*.pyc

# all working files (source videos, renders, cache, projects, assets, upload
# schedule) -- not code. Its README IS tracked (see the exception below) so
# anyone who clones knows what the folder is for without reading server.py.
workspace/*
!workspace/README.md

