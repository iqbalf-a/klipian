  "claims": [
    {
      "text": "Cegukan adalah kontraksi tiba-tiba dan tidak disengaja dari otot diafragma, diikuti oleh penutupan mendadak pita suara yang menghasilkan bunyi khas.",
      "beats": ["diafragma", "bunyi"],
      "sources": ["https://en.wikipedia.org/wiki/Hiccup"]
    },
    {
      "text": "Janin manusia dapat mengalami cegukan mulai dari usia 9 minggu dalam kandungan; cegukan ini diyakini sebagai latihan otot pernapasan sebelum lahir.",
      "beats": ["janin"],
      "sources": ["https://pubmed.ncbi.nlm.nih.gov/7673562/"]
    },
    {
      "text": "Charles Osborne dari Amerika Serikat memegang rekor dunia cegukan terlama: ia cegukan selama 68 tahun tanpa henti, dari 1922 hingga 1990.",
      "beats": ["rekor"],
      "sources": ["https://www.guinnessworldrecords.com/world-records/longest-attack-of-hiccups"]
    }
  ],
  "post": {
    "description": "Cegukan ternyata punya fakta sains yang mengejutkan! Mulai dari cara kerja diafragma, fakta janin yang sudah bisa cegukan sejak 9 minggu dalam kandungan, hingga rekor dunia cegukan 68 tahun nonstop. Intip semuanya di sini.",
    "hashtags": ["#faktacegukan", "#faktaseru", "#sains", "#intipyuk", "#shorts"]
  },
