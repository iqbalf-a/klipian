# Copy this file to .env and fill in the values. .env is NOT committed
# (see .gitignore) -- this example file is, without the real values.

# HuggingFace token (read-only is enough), used ONCE to download the weights
# of the speaker-diarization-community-1 model (the AI Framing feature).
# Create a token at:
# https://huggingface.co/settings/tokens
# The model is gated -- accept access on the model's own page as well before
# the token can be used to download it:
# https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=
